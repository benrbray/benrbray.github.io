---
import { getPostUrl, postIsPublished } from '@root/util/query';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../dates/FormattedDate.astro';
import type { RenderedContent } from 'node_modules/astro/dist/content/data-store';
// import PostTags from './PostTags.astro';
interface Props {
  post: CollectionEntry<'post'>;
  show?: { summary?: boolean, image?: boolean, tags?: boolean }
}

const { post, show: showProps } = Astro.props;

const show = Object.assign({ summary: true, image: true, tags: true }, showProps);

const postUrl = getPostUrl(post);
const postDisplayTitle = post.data.titleDisplay || post.data.title;

const postCategory = post.data.tags?.at(0) || null;
const isProject = post.data.kind === "project";

const showSummary = post.data.priority == "normal" && show.summary; //isProject && show.summary;
const showImage = false; //post.data.imageThumbnail && show.image;
const showSummaryBody = (showSummary || showImage);

const summaryDisplay = (post.data as any)["summaryDisplay"] as RenderedContent
---


<div class:list={[
  "post-summary",
  `priority-${post.data.priority}`,
  `kind-${post.data.kind === "project" ? "project" : "post"}`,
]}>
  <!-- summary -->
  <div class="category" data-category={postCategory}>
    <div class="label">{postCategory}</div>
  </div>
  <div class="summary-header">
    <!-- title -->
    <div class="title">
      <a href={postUrl}
        class:list={[{ unpublished: !postIsPublished(post) }]}
        set:html={postDisplayTitle}
      />
    </div>
    <!-- summary -->
    {
      showSummaryBody && <>
        {(post.data as any)["summaryDisplay"]
          ? <div set:html={summaryDisplay.html} />
          : <div class="description" set:html={post.data.summary} />
        }
      </>
    }
    <!-- year -->
    <div class="year"><FormattedDate date={post.data.datePublished} /></div>
    <!-- {
      show.tags &&
      <div class="header-subtitle">
        <PostTags
          tags={post.data.tags || []}
          tools={post.data.tools || []}
          formats={ post.data.format? [post.data.format] : [] }
        />
      </div>
    } -->
  </div>
  <!-- <div class="summary-thumbnail">
    <img src={post.data.imageThumbnail}/>
  </div> -->
  <!-- { showSummaryBody &&
    <div class="summary-body">
    {
      // summary
      showSummary &&
      <div class="summary" set:html={post.data.summary} />
    }{
      // thumbnail
      showImage &&
      (<div class="thumb">
        <img alt="" src={post.data.imageThumbnail} />
      </div>)
    }
    </div>
  } -->
</div>

<style>
.post-summary {
  padding: 8px;
  border-radius: 8px;

  display: flex;
  gap: 10px;
  align-items: stretch;
}

.post-summary .category       { flex: 0 1 2em; }
.post-summary .summary-header { flex: 5; }
.post-summary .summary-thumbnail { flex: 0 1 8em; }

.post-summary .summary-thumbnail {
  display: flex;
  align-items: stretch;
  justify-content: stretch;
}
.post-summary .summary-thumbnail img {
  display: block;
  margin: 0;
  object-fit: cover;
}

.post-summary:has(.title a:hover) {
  transition: background-color 20ms ease-in;
  background-color: #eee;
}
.post-summary {
  transition: background-color 60ms ease-out;
}

.post-summary .summary-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.post-summary .summary-header .title {
  font-size: 1.1em;
  font-weight: 500;
}

.post-summary .summary-header .description {
  text-wrap: pretty;
  line-height: var(--line-height);
}

/* .header-title .title    { flex: 1; }
.header-title .category { flex: 0 0 2em; border: 1px solid red; }
.header-title .year     { flex: 0; } */

.post-summary .year {
  /* font-weight: var(--font-normal-weight); */
  /* font-size: var(--font-size-normal); */
  color: gray;
  white-space: nowrap;
}

.post-summary .category {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;

  --category-color-bg: white;
  --category-color-fg: #888;
  
  background-color: var(--category-color-bg);
  border: 1px solid var(--category-color-fg);
  color: var(--category-color-fg);
  
  font-size: 0.8em;
  border-radius: 4px;

}

.post-summary .category .label {
  position: absolute;
  display: inline-block;
  transform: rotate(-90deg);
}

.post-summary .category[data-category="math"] {
  --category-color-bg: #99c6d3;
  --category-color-fg: #003e4f;
}

.post-summary .category[data-category="plt"] {
  --category-color-bg: #a8c7ab;
  --category-color-fg: #004115;
}

.post-summary .category[data-category="crafts"] {
  --category-color-bg: #c8b5d6;
  --category-color-fg: #442458;
}

.post-summary .category[data-category="code"] {
  --category-color-bg: #cdbb99;
  --category-color-fg: #4a2f00;
}

.post-summary .category[data-category="ml"] {
  --category-color-bg: #dab0bc;
  --category-color-fg: #512434;
}

